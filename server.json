{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.rohan9024/retrykit",
  "description": "AI/LLM retry diagnostics, SDK double-retry audit, and fault evaluation MCP server.",
  "repository": {
    "url": "https://github.com/rohan9024/retrykit",
    "source": "github"
  },
  "version": "3.0.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@rohan9024/retrykit",
      "version": "3.0.0",
      "transport": { "type": "stdio" },
      "packageArguments": [{ "type": "positional", "value": "mcp", "isRequired": true }]
    }
  ]
}
