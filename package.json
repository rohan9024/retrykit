{
  "name": "@rohan9024/retrykit",
  "version": "0.3.0",
  "description": "Provider-aware retries, rate-limit intelligence, and request resilience for Node.js and TypeScript AI applications.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "llms.txt",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rohan9024/retrykit.git"
  },
  "homepage": "https://github.com/rohan9024/retrykit#readme",
  "bugs": {
    "url": "https://github.com/rohan9024/retrykit/issues"
  },
  "keywords": [
    "retry",
    "resilience",
    "rate-limit",
    "llm",
    "openai",
    "anthropic",
    "groq",
    "azure-openai",
    "gemini",
    "fetch",
    "backoff",
    "circuit-breaker",
    "streaming"
  ],
  "author": "rohan9024",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}