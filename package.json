{
  "name": "@rohan9024/retrykit",
  "version": "0.1.0",
  "description": "Zero-dependency, header-aware network retry library tailored for LLM APIs and fetch.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "llms.txt",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run test && npm run build"
  },
  "keywords": [
    "retry",
    "fetch",
    "llm",
    "openai",
    "anthropic",
    "backoff",
    "jitter",
    "exponential-backoff",
    "rate-limit",
    "retry-after"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "directories": {
    "test": "test"
  }
}
