{
  "name": "@rohan9024/retrykit",
  "version": "1.1.0",
  "description": "The AI Resilience & Continuity Engine: Provider-aware rate-limits, key-pool rotation, context auto-healing, and budget guards.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js",
      "require": "./dist/register.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": [
    "retry",
    "openai",
    "anthropic",
    "gemini",
    "groq",
    "deepseek",
    "rate-limit",
    "key-rotation",
    "context-window",
    "circuit-breaker",
    "ai-agents",
    "resilience",
    "llm"
  ],
  "author": "Rohan Wandre <rohanwandre24@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rohan9024/retrykit.git"
  },
  "bugs": {
    "url": "https://github.com/rohan9024/retrykit/issues"
  },
  "homepage": "https://github.com/rohan9024/retrykit#readme",
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  }
}
