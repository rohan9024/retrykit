{
  "name": "@rohan9024/retrykit",
  "version": "3.0.0",
  "mcpName": "io.github.rohan9024/retrykit",
  "description": "Zero-dependency TypeScript reliability layer for LLM retries, AI API rate limits, replay-safe HTTP, streaming recovery, circuit breakers, and MCP.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.mjs",
      "require": "./dist/register.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.mjs",
      "require": "./dist/core.js"
    },
    "./fetch": {
      "types": "./dist/fetch.d.ts",
      "import": "./dist/fetch.mjs",
      "require": "./dist/fetch.js"
    },
    "./stream": {
      "types": "./dist/stream.d.ts",
      "import": "./dist/stream.mjs",
      "require": "./dist/stream.js"
    },
    "./compaction": {
      "types": "./dist/compaction.d.ts",
      "import": "./dist/compaction.mjs",
      "require": "./dist/compaction.js"
    },
    "./budget": {
      "types": "./dist/budget.d.ts",
      "import": "./dist/budget.mjs",
      "require": "./dist/budget.js"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "import": "./dist/auto.mjs",
      "require": "./dist/auto.js"
    },
    "./validate": {
      "types": "./dist/validate.d.ts",
      "import": "./dist/validate.mjs",
      "require": "./dist/validate.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.mjs",
      "require": "./dist/mcp.js"
    },
    "./ai-sdk": {
      "types": "./dist/ai-sdk.d.ts",
      "import": "./dist/ai-sdk.mjs",
      "require": "./dist/ai-sdk.js"
    },
    "./policy/classify": {
      "types": "./dist/policy/classify.d.ts",
      "import": "./dist/policy/classify.mjs",
      "require": "./dist/policy/classify.js"
    },
    "./policy/replay-safety": {
      "types": "./dist/policy/replay-safety.d.ts",
      "import": "./dist/policy/replay-safety.mjs",
      "require": "./dist/policy/replay-safety.js"
    },
    "./otel": {
      "types": "./dist/otel.d.ts",
      "import": "./dist/otel.mjs",
      "require": "./dist/otel.js"
    },
    "./stores/upstash": {
      "types": "./dist/stores/upstash.d.ts",
      "import": "./dist/stores/upstash.mjs",
      "require": "./dist/stores/upstash.js"
    },
    "./testing": {
      "types": "./dist/testing/chaos.d.ts",
      "import": "./dist/testing/chaos.mjs",
      "require": "./dist/testing/chaos.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.mjs",
      "require": "./dist/client.js"
    }
  },
  "sideEffects": false,
  "bin": {
    "retrykit": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "AGENTS.md",
    "context7.json",
    "llms.txt",
    "llms-full.txt",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "retry",
    "llm-retry",
    "ai-retry",
    "openai",
    "anthropic",
    "gemini",
    "groq",
    "deepseek",
    "rate-limit",
    "retry-after",
    "key-rotation",
    "context-window",
    "circuit-breaker",
    "ai-agents",
    "resilience",
    "llm",
    "streaming",
    "vercel-ai-sdk",
    "mcp",
    "typescript",
    "nodejs"
  ],
  "author": "Rohan Wandre <rohanwandre24@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rohan9024/retrykit.git"
  },
  "bugs": {
    "url": "https://github.com/rohan9024/retrykit/issues"
  },
  "homepage": "https://github.com/rohan9024/retrykit#readme",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  }
}
